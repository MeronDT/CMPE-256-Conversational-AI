# Copy to .env and fill in. Any OpenAI-compatible provider works.

# --- OpenAI (default) ---
LLM_API_KEY=sk-...
LLM_MODEL=gpt-5-mini
LLM_BASE_URL=

# --- Groq (free tier) ---
# LLM_API_KEY=gsk_...
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.3-70b-versatile

# --- Google Gemini (free tier) ---
# LLM_API_KEY=...
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_MODEL=gemini-2.5-flash

# Optional: reasoning effort for reasoning models (minimal|low|medium|high)
# LLM_REASONING_EFFORT=low

# Optional: hours before re-downloading FRED data (default 12)
# FRED_CACHE_HOURS=12
